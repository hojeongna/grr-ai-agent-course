<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.example.agent-scheduler</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/절대경로를/여기에/my-agent/scripts/scheduler_daemon.py</string>
    </array>

    <!-- 로그인할 때 자동 시작 -->
    <key>RunAtLoad</key>
    <true/>
    <!-- 죽으면 자동 재시작 -->
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/agent-scheduler.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/agent-scheduler.error.log</string>
</dict>
</plist>
