# 2강 전용 값입니다. 1강에서 만든 .env(같은 프로젝트)에 아래 값을 이어서 추가하세요.
# 새 .env 파일을 따로 만들 필요 없습니다 — 하나의 .env를 계속 씁니다.

# Claude Code가 떠 있는 tmux 세션 이름 (tmux new -s agent 로 만든 이름과 맞추기)
TMUX_SESSION=agent

# RSS가 있는 소스 (news_poll.py) — 관심있는 블로그/뉴스레터/유튜브 채널 등 아무 RSS 피드
RSS_FEED_URL=관심있는_RSS_피드_URL

# RSS가 없는 소스 (선택) — 에이전트가 WebFetch로 직접 확인할 공개 페이지 URL
# 비워두면 이 스케줄(WATCH_CHECK)은 그냥 건너뜁니다.
WATCH_URL=

# WATCH_URL이 React/SPA 사이트(예: Threads)라 본문이 <script> 안 JSON에만 있으면
# 반드시 설정하세요 — 안 하면 해시가 영원히 고정돼 새 글을 절대 못 잡습니다
# (README "claude -p OAuth 인증 실패" 옆 섹션 대신, 아래 예시가 관련 설명입니다).
# Threads라면 이 값 그대로 쓰면 됩니다. 다른 SPA 사이트는 Googlebot UA로 받은
# HTML을 직접 열어보고 게시글마다 반복되는 고유 마커를 찾아 정규식을 바꾸세요.
WATCH_HASH_REGEX="code":"([A-Za-z0-9_-]{6,})"
